# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# Approved marketing template with one text body parameter: {{1}}
WHATSAPP_MARKETING_TEMPLATE_NAME=
WHATSAPP_MARKETING_TEMPLATE_LANGUAGE=en_US

# Keep conservative concurrency unless Meta account capacity is increased.
WHATSAPP_SEND_CONCURRENCY=5

# Reserved for the future webhook endpoint. It is not used by this MVP.
WHATSAPP_VERIFY_TOKEN=
